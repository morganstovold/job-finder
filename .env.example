# Where alerts go. Must be a verified destination address in Cloudflare Email Routing.
NOTIFY_EMAIL=you@example.com
# Sender - any address on a domain with Email Routing enabled (default jobs@stovold.dev).
FROM_EMAIL=jobs@stovold.dev
# Optional free push alerts: install the ntfy app, subscribe to this topic. Make it long & random.
NTFY_TOPIC=morgan-stovold-emt
# Optional ntfy access token (tk_...) from ntfy.sh → Account → Access tokens.
# Rate limits then count against your account instead of Cloudflare's shared IP. Stored as a Worker secret.
NTFY_TOKEN=
# Optional: unlocks /run?key=... and /test?key=... on the worker URL.
ADMIN_KEY=
