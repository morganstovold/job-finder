# Where alerts go. Must be a verified destination address in Cloudflare Email Routing.
NOTIFY_EMAIL=you@example.com
# Sender - any address on a domain with Email Routing enabled (default jobs@stovold.dev).
FROM_EMAIL=jobs@stovold.dev
# Optional Pushover push alerts (https://pushover.net, $5 one-time per platform). Both are stored as Worker secrets.
# User key: shown on your Pushover dashboard after you log in.
PUSHOVER_USER=
# App API token: Pushover dashboard → "Create an Application/API Token".
PUSHOVER_TOKEN=
# Optional: unlocks /run?key=... and /test?key=... on the worker URL.
ADMIN_KEY=
# Optional test flag: announcement reminder offsets in minutes before opening (default 1440,60 = 24h,1h).
# REMINDER_OFFSETS_MIN=90,30
